APP_NAME="GuMa | Biblioteca Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=guma_biblioteca_session
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Dados do banco em Project Settings > Database do Supabase.
# ATENCAO: use credenciais do pooler compativeis com a rede Docker;
# se houver conflito IPv4, prefira o pooler de sessao na porta 5432.
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.diugqrslyiijkithaycy
DB_PASSWORD=COLOQUE_SUA_SENHA_DO_BANCO
DB_SSLMODE=require

# Configuracoes do Supabase
SUPABASE_URL=https://diugqrslyiijkithaycy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ggAUrz2q42Xg-cdgDvX6Bw_cl2DhJTA
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://diugqrslyiijkithaycy.supabase.co/auth/v1/.well-known/jwks.json

# Pepper de servidor aplicado via HMAC-SHA256 antes de enviar a senha ao Supabase Auth.
PASSWORD_PEPPER=guma_biblioteca_pepper_2026

FRONTEND_URL=http://localhost:5173

# Opcional: Google Books API — restrinja a chave no Google Cloud às APIs necessárias.
# Como a consulta ocorre no servidor, nunca adicione esta chave ao VITE_*.
GOOGLE_BOOKS_API_KEY=AIzaSyAZ7wqOEQ1oBjYUnS9u8xupG3jReA3q_5g
