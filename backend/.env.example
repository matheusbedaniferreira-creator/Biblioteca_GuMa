APP_NAME="Biblioteca Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=folha_biblioteca_session
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Dados do banco em Project Settings > Database do Supabase.
# ATENCAO: use credenciais do pooler compativeis com a rede Docker;
# se houver conflito IPv4, prefira o pooler de sessao na porta 5432.
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=COLOQUE_SUA_SENHA_DO_BANCO
DB_SSLMODE=require

# Authentication > URL / Project Settings > API; nunca use service_role aqui.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

FRONTEND_URL=http://localhost:5173

# Opcional: Google Books API — restrinja a chave no Google Cloud às APIs necessárias.
# Como a consulta ocorre no servidor, nunca adicione esta chave ao VITE_*.
GOOGLE_BOOKS_API_KEY=
